# Copy to .env before running docker compose up.
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_DATABASE=masroof
MYSQL_USER=masroof
MYSQL_PASSWORD=change-this-database-password
JWT_SECRET_KEY=replace-with-a-long-random-secret
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
OPENROUTER_CHAT_FALLBACK_MODELS=google/gemini-2.0-flash-001
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b:free
AGENT_ENABLED=true
AGENT_SYNC_ENABLED=true
AGENT_SYNC_INTERVAL_SECONDS=300
AGENT_INDEX_MAX_EXPENSES=20000
HTTP_PORT=8080
# Optional for HTTPS: set a real DNS name and run docker compose --profile https up -d
PUBLIC_DOMAIN=localhost
