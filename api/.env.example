# Copy to .env and adjust. Every key maps to a field in app/core/config.py.

# --- Database (MariaDB) ---
DATABASE_URL=mysql+pymysql://expense:expense@localhost:3306/expense_db

# --- JWT ---
# Generate a real one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-in-real-environments

# --- Seeded superuser (used only by `python -m app.seed`) ---
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=ChangeMe!123

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=Expenses <no-reply@example.com>
# When false, EmailService logs messages instead of sending them (handy in dev).
EMAIL_ENABLED=false

# --- Attachments ---
UPLOAD_DIR=uploads

# --- AI service (your own model; leave empty to use the built-in stub) ---
AI_SERVICE_URL=

# --- CORS: JSON list of allowed front-end origins ---
CORS_ORIGINS=["http://localhost:5173"]
