# Copy to the Compose project root as .env and set real secrets.
APP_NAME=Masroof API
ENVIRONMENT=development
DATABASE_URL=mysql+pymysql://masroof:masroof_demo_password@db:3306/masroof?charset=utf8mb4
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
OPENROUTER_CHAT_FALLBACK_MODELS=google/gemini-2.0-flash-001
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b:free
AGENT_ENABLED=true
AGENT_READONLY_DATABASE_URL=
AGENT_CHROMA_PATH=app/agent/data/chroma
AGENT_EMBEDDING_DIMENSIONS=512
AGENT_EMBED_BATCH_SIZE=32
AGENT_SYNC_ENABLED=true
AGENT_SYNC_INTERVAL_SECONDS=300
AGENT_INDEX_MAX_EXPENSES=20000
AGENT_MAX_HISTORY_MESSAGES=10
AGENT_MAX_TOOL_CALLS=6
AGENT_REQUEST_TIMEOUT_SECONDS=45
AGENT_RATE_LIMIT_PER_MINUTE=20
USD_TO_SAR_RATE=3.75
